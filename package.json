{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write .",
    "generate:erd": "npx prisma generate",
    "supabase": "npx supabase",
    "supabase:generate": "npx supabase gen types typescript --project-id jaalpvmewopvczojgpct > lib/types/database.types.ts",
    "supabase:make-migration": "npx supabase migration new",
    "supabase:migrate": "npx supabase db push",
    "postsupabase:migrate": "yarn supabase:generate"
  },
  "prisma": {
    "schema": "server/schema.prisma"
  },
  "dependencies": {
    "@hebilicious/vue-query-nuxt": "^0.3.0",
    "@nuxtjs/tailwindcss": "^6.11.4",
    "@popperjs/core": "^2.11.8",
    "@supabase/gotrue-js": "^2.62.2",
    "@tanstack/vue-query": "^5.29.0",
    "@vee-validate/zod": "^4.12.6",
    "@vueuse/core": "^10.9.0",
    "axios": "^1.6.8",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "crypto-js": "^4.2.0",
    "date-fns": "^3.6.0",
    "embla-carousel": "^8.0.0",
    "embla-carousel-vue": "^8.0.0",
    "lucide-vue-next": "^0.344.0",
    "nuxt": "^3.10.3",
    "radix-vue": "^1.4.9",
    "shadcn-nuxt": "^0.9.0",
    "tailwind-merge": "^2.2.1",
    "tailwindcss-animate": "^1.0.7",
    "v-calendar": "^3.1.2",
    "vee-validate": "^4.12.6",
    "vue": "^3.4.19",
    "vue-error-boundary": "^2.0.3",
    "vue-router": "^4.3.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^10.8.0",
    "@nuxtjs/google-fonts": "^3.1.3",
    "@nuxtjs/supabase": "^1.2.0",
    "@prisma/client": "^5.10.2",
    "@types/crypto-js": "^4.2.2",
    "prettier": "^3.2.5",
    "prisma": "^5.10.2",
    "prisma-dbml-generator": "^0.12.0",
    "prisma-erd-generator": "^1.11.2",
    "prisma-markdown": "^1.0.9",
    "typescript": "^5.4.2"
  }
}
