    "embla-carousel": "^8.0.0",
    "embla-carousel-vue": "^8.0.0",
    "lucide-vue-next": "^0.344.0",
    "nuxt": "^3.10.3",
    "radix-vue": "^1.4.9",
    "shadcn-nuxt": "^0.9.0",
    "tailwind-merge": "^2.2.1",
    "tailwindcss-animate": "^1.0.7",
    "vue": "^3.4.19",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^10.8.0",
    "@nuxtjs/google-fonts": "^3.1.3",
    "@prisma/client": "^5.10.2",
    "prettier": "^3.2.5",
